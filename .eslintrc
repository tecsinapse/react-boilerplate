{
  "plugins": ["eslint-plugin-no-inline-styles", "prettier"],
  "extends": [
    "@tecsinapse/eslint-config-tecsinapse-js",
    "plugin:prettier/recommended"
  ],
  "settings": {
    "import/resolver": {
      "node": {
        "moduleDirectory": ["node_modules", "src/"]
      }
    }
  },
  "rules": {
    "react/jsx-props-no-spreading": "off"
  }
}
